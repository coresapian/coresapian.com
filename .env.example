# =============================================================================
# CoreSapian.com — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# .env is gitignored — never commit real credentials.
# =============================================================================

# --- Proxmox ---
PROXMOX_HOST="root@192.168.0.10"
CT_ID=103
CT_IP="192.168.0.148"

# --- coreChat ---
CORECHAT_REMOTE_DIR="/opt/coresapian/corechat"
CORECHAT_PORT=9000
CORECHAT_NODE_MAJOR=20

# --- Godot Dedicated Server ---
GODOT_BIN="godot4"
GODOT_SERVER_DIR="/opt/coresapian/godot"

# --- Cloudflare (for tunnel management) ---
CLOUDFLARE_ACCOUNT_ID="YOUR_ACCOUNT_ID"
CLOUDFLARE_TUNNEL_ID="YOUR_TUNNEL_ID"
CLOUDFLARE_API_TOKEN=***

# --- World Chat API Keys (comma-separated) ---
CORE_CHAT_API_KEYS=***

# --- Game Login Defaults (auto-filled in lobby) ---
PLAYER_NAME="Core"
GAME_SERVER_IP="coresapian.com"
GAME_SERVER_PORT=7000
