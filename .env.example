# =============================================================================
# CoreSapian.com — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# .env is gitignored — never commit real credentials.
# =============================================================================

# --- Proxmox LXC 103 (web + chat server) ---
DEPLOY_HOST="root@192.168.0.148"
WEB_ROOT="/var/www/coresapian"
CHAT_SERVER_DIR="/opt/coresapian/server"

# --- Anonymous Chat Server (Node.js, port 3001) ---
CHAT_WS_PORT=3001
CHAT_LOG_FILE="/data/chatlog.json"
CHAT_MAX_MESSAGES=200
CHAT_MAX_CLIENTS=500

# --- Cloudflare (for tunnel management) ---
CLOUDFLARE_ACCOUNT_ID="<your-account-id>"
CLOUDFLARE_TUNNEL_ID="<your-tunnel-id>"
CLOUDFLARE_API_TOKEN="<your-token-here>"

# --- Game (lobby defaults) ---
PLAYER_NAME="Core"
GAME_SERVER_IP="coresapian.com"
GAME_SERVER_PORT=7000
