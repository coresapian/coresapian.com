# ── Consumables ─────────────────────────────────────────────

[sub_resource type="ItemDefinition" id="ItemDefinition_health_potion"]
id = "health_potion"
max_stack = 20
name = "Health Potion"
weight = 0.5
properties = {
"heal_amount": 25.0,
"rarity": "common"
}
categories = Array[ItemCategory]([SubResource("ItemCategory_consumable")])
description = "Restores 25 HP when consumed."

[sub_resource type="ItemDefinition" id="ItemDefinition_mana_potion"]
