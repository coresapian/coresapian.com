[Unit]
Description=CoreSapian Godot Dedicated Server
After=network.target
Wants=nginx.service

[Service]
Type=simple
ExecStart=/opt/coresapian/godot/coresapian-server.x86_64 --headless
WorkingDirectory=/opt/coresapian/godot
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/coresapian/godot /opt/coresapian/data

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
